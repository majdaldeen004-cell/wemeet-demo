# The demo needs NO environment variables and NO credentials.
# Both values below are optional public OpenStreetMap endpoints used by the map
# screens; the defaults in src/lib/maps/loader.ts work without them.
NEXT_PUBLIC_OSM_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
NEXT_PUBLIC_NOMINATIM_URL=https://nominatim.openstreetmap.org
